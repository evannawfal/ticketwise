{
  "name": "@ticketwise/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/store/pg.d.ts",
      "default": "./dist/store/pg.js"
    },
    "./bedrock": {
      "types": "./dist/providers/bedrock.d.ts",
      "default": "./dist/providers/bedrock.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
