# Local development (npm run dev:api). Copy to .env and `set -a; source .env; set +a`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticketwise
ADMIN_TOKEN=change-me-to-a-long-random-string

# local = no API keys needed (hashed embeddings + extractive answers)
# bedrock = Titan embeddings + Claude via AWS Bedrock (uses your AWS credentials)
# openai = text-embedding-3-small + gpt-4o-mini
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# PG_ALLOW_SELF_SIGNED=1   # only if your Postgres uses a private CA

# Approved answers: off | prefer (default) | only
# APPROVED_MODE=prefer
# APPROVED_THRESHOLD=        # default depends on the embedding provider (see tuningFor)

# Request queue for model calls. Set these to your provider's limits.
# LLM_MAX_CONCURRENT=4
# LLM_REQUESTS_PER_MINUTE=50
# LLM_TOKENS_PER_MINUTE=100000
# LLM_MAX_QUEUE=100           # waiting requests before new ones get 429
# LLM_QUEUE_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=4
# LLM_SHARED_BUDGET=1         # keep the budget in Postgres, shared by every process (the AWS deploy sets this)

# Slack (optional locally; expose the server with a tunnel like ngrok)
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=xoxb-...
